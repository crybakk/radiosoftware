{
  "name": "radio-regia",
  "productName": "Radio Regia",
  "version": "0.1.0",
  "description": "Software di regia radiofonica: playout, diretta remota, streaming",
  "main": "out/main/index.js",
  "author": "cristian",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "it.radioregia.app",
    "productName": "Radio Regia",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/@node-llama-cpp/*-vulkan*/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/essentia.js/**",
      "out/main/djWorker.js",
      "out/main/chunks/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RadioRegia-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build-resources/fpcalc",
        "to": "fpcalc",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "crybakk",
        "repo": "radiosoftware",
        "releaseType": "prerelease"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.5.0",
    "node-llama-cpp": "3.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "1.13.8"
  }
}
