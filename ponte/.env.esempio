# ===== Ponte di Radio Regia: impostazioni =====
# Copia questo file in ".env" e compila i valori. Non condividere il file .env: contiene password.

NOME_RADIO=La mia radio
# Nome di dominio della radio (deve puntare all'IP pubblico di casa). Serve per l'HTTPS automatico:
# Caddy chiede da solo il certificato Let's Encrypt (porte 80 e 443 inoltrate dal router al server).
DOMINIO=radio.esempio.it

# --- Collegamento dalla regia (SRT, UDP) ---
SRT_PORT=9000
# Frase segreta condivisa con la regia (da 10 a 79 caratteri). Vuota = nessuna cifratura (sconsigliato).
SRT_PASSPHRASE=
# Secondi di audio tenuti in memoria dal ponte per assorbire i buchi del 4G
SRT_BUFFER_SECONDS=10

# --- Servizio di controllo (allarmi, titoli in onda, backup, pannello) ---
# Si raggiunge da https://DOMINIO (porta 443, tramite Caddy).
# Token lungo e casuale (almeno 16 caratteri), da inserire anche nella regia
CONTROLLO_TOKEN=

# --- Pannello remoto (nel browser: https://DOMINIO) ---
# Password dell'utente "admin", creato al primo avvio se non c'è nessun utente (almeno 8 caratteri).
# Gli altri utenti si creano dal pannello stesso (menu ☰ → Utenti).
PANNELLO_ADMIN_PASSWORD=

# --- Icecast principale (sullo stesso server): qui si collegano gli ascoltatori ---
# Ascolto: https://DOMINIO/radio.mp3 (oppure http://DOMINIO:8000/radio.mp3)
# Stato e titolo in onda: https://DOMINIO/status-json.xsl
ICECAST_MOUNT=/radio.mp3
# Qualità MP3 in kbit/s, uguale per l'Icecast principale e il secondario
ICECAST_BITRATE=128
# Password con cui il ponte trasmette (utente "source") e password dell'amministrazione
# di Icecast (utente "admin", pagina http://DOMINIO:8000/admin/)
ICECAST_PASSWORD_SORGENTE=
ICECAST_PASSWORD_ADMIN=
# Ascoltatori al massimo. Conta la banda in upload di casa: ogni ascoltatore a 128 kbit/s
# usa 0,128 Mbit/s (per esempio 20 Mbit/s in upload ≈ 150 ascoltatori).
ICECAST_MAX_ASCOLTATORI=1000
# Porta HTTP diretta di Icecast (per i lettori che non usano https)
ICECAST_PORTA=8000

# --- Dirette esterne ---
# Ingresso per l'app che usavi per collegarti come DJ ad AzuraCast (Icecast, es. BUTT, Larix, Luci Live).
# La porta deve essere diversa da ICECAST_PORTA.
# Quando l'app si collega ha la precedenza sulla regia; quando si scollega torna la regia.
# Password vuota = ingresso disattivato.
ESTERNA_PORTA=9010
ESTERNA_MOUNT=/
ESTERNA_UTENTE=esterna
ESTERNA_PASSWORD=

# --- Microfono remoto dal pannello (WebRTC) ---
# Il conduttore parla dal browser (telefono o computer): la musica si abbassa e in cuffia
# torna il programma senza la propria voce. Funziona solo con il pannello in HTTPS.
MICROFONO_REMOTO=si
# Di quanto si abbassa la musica quando il microfono è in onda (dB, negativo)
ABBASSAMENTO_MUSICA_DB=-12
# Porte UDP per l'audio del microfono: vanno inoltrate dal router verso il server
WEBRTC_PORTE=40000-40049
# Server STUN usato per trovare la strada tra browser e ponte (vuoto = nessuno)
WEBRTC_STUN=stun:stun.l.google.com:19302
# Indirizzi in più da annunciare al browser, separati da virgola (per esempio l'IP del server
# nella rete di casa). Il nome con cui si apre il pannello è già incluso da solo.
WEBRTC_INDIRIZZI=

# --- Ospiti collegati con un link (dal pannello: sezione Ospiti) ---
# Indirizzo di ascolto fatto sentire agli ospiti in sala d'attesa.
# Vuoto = quello dell'Icecast principale (https://DOMINIO/radio.mp3).
ASCOLTO_URL=

# --- Icecast secondario (esterno, su un altro server): stesso identico segnale del principale ---
# Se il server di casa non è raggiungibile, gli ascoltatori passano a questo. Host vuoto = disattivato.
ICECAST_ESTERNO_HOST=
ICECAST_ESTERNO_PORTA=8000
ICECAST_ESTERNO_MOUNT=/radio.mp3
ICECAST_ESTERNO_UTENTE=source
ICECAST_ESTERNO_PASSWORD=
# Per le statistiche degli ascoltatori: se la pagina pubblica status-json.xsl del secondario è chiusa,
# metti utente e password di amministrazione di quell'Icecast (vuoto = si usa solo la pagina pubblica).
ICECAST_ESTERNO_ADMIN_UTENTE=admin
ICECAST_ESTERNO_ADMIN_PASSWORD=

# --- Musica di riserva ---
# Quando non c'è né regia né diretta autonoma né esterna, il ponte manda in onda da solo musica
# a caso dalla libreria del server (cartella "musica"), senza ripetere di seguito lo stesso artista.

# --- Dirette video su YouTube e Facebook (dal pannello: sezione Dirette video) ---
# Chiavi delle dirette e logo si impostano dal pannello. L'audio è il programma del ponte.
DIRETTE_VIDEO=si
# Porta UDP su cui OBS manda il video (SRT): da inoltrare sul router se usi OBS da fuori casa
VIDEO_OBS_PORTA=9020
# Frase segreta per OBS (da 10 a 79 caratteri). Vuota = nessuna cifratura.
VIDEO_OBS_PASSPHRASE=

# --- Riconoscimento dei brani nelle dirette esterne (impronte mandate dalla regia) ---
# I brani sconosciuti si etichettano dal pannello. "no" per spegnerlo.
RICONOSCIMENTO=si

# --- Programmi e puntate on demand (dal pannello: menu Programmi) ---
# Ogni programma con le sue fasce si registra da solo; le bozze si rivedono e si pubblicano dal pannello.
# Pagine per gli ascoltatori: https://DOMINIO/ascolta.html e https://DOMINIO/podcast.html
# "no" per non registrare. Qualità delle registrazioni (MP3): 128k ≈ 58 MB all'ora.
REGISTRAZIONE_PUNTATE=si
PUNTATE_BITRATE=128k

# --- Processore audio: spento | leggero | medio | forte ---
PROCESSORE_AUDIO=medio

# --- Allarmi ---
ALLARME_SILENZIO_SECONDI=20
ALLARME_SCOLLEGATO_SECONDI=30
ALLARME_REGIA_MUTA_SECONDI=90
ALLARME_RICONNESSIONI=5

# Telegram (facoltativo): token del bot da @BotFather e id della chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (facoltativo)
SMTP_HOST=
SMTP_PORTA=587
SMTP_SSL=no
SMTP_UTENTE=
SMTP_PASSWORD=
EMAIL_MITTENTE=
EMAIL_DESTINATARI=

# --- Backup del database della regia ---
BACKUP_DA_TENERE=14
