# ===== Ponte di Radio Regia: impostazioni =====
# Copia questo file in ".env" e compila i valori. Non condividere il file .env: contiene password.

NOME_RADIO=La mia radio

# --- Collegamento dalla regia (SRT, UDP) ---
SRT_PORT=9000
# Frase segreta condivisa con la regia (da 10 a 79 caratteri). Vuota = nessuna cifratura (sconsigliato).
SRT_PASSPHRASE=
# Secondi di audio tenuti in memoria dal ponte per assorbire i buchi del 4G
SRT_BUFFER_SECONDS=10

# --- Servizio di controllo (allarmi, titoli in onda, backup) ---
CONTROLLO_PORTA=8090
# Token lungo e casuale (almeno 16 caratteri), da inserire anche nella regia
CONTROLLO_TOKEN=

# --- AzuraCast: stessi dati che usa oggi RadioDJ per andare in diretta (Streamer/DJ) ---
# Se AzuraCast è sullo stesso server: host.docker.internal
AZURACAST_HOST=host.docker.internal
AZURACAST_PORTA_DJ=8005
AZURACAST_MOUNT_DJ=/
AZURACAST_DJ_UTENTE=
AZURACAST_DJ_PASSWORD=

# --- Processore audio: spento | leggero | medio | forte ---
PROCESSORE_AUDIO=medio

# --- Allarmi ---
ALLARME_SILENZIO_SECONDI=20
ALLARME_SCOLLEGATO_SECONDI=30
ALLARME_REGIA_MUTA_SECONDI=90
ALLARME_RICONNESSIONI=5

# Telegram (facoltativo): token del bot da @BotFather e id della chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (facoltativo)
SMTP_HOST=
SMTP_PORTA=587
SMTP_SSL=no
SMTP_UTENTE=
SMTP_PASSWORD=
EMAIL_MITTENTE=
EMAIL_DESTINATARI=

# --- Backup del database della regia ---
BACKUP_DA_TENERE=14
