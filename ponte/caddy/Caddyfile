# HTTPS automatico per il server della radio. Caddy ottiene e rinnova da solo il certificato
# Let's Encrypt per DOMINIO (servono le porte 80 e 443 inoltrate dal router verso il server).
{$DOMINIO} {
	# ascolto della radio e stato di Icecast (titolo in onda, ascoltatori); amministrazione di Icecast
	# solo da qui, in HTTPS (https://DOMINIO/admin/)
	@icecast path {$ICECAST_MOUNT} /status-json.xsl /admin /admin/*
	handle @icecast {
		reverse_proxy icecast:8000 {
			# lo stream va passato subito, senza buffer
			flush_interval -1
		}
	}
	# flusso HLS (indirizzi come AzuraCast: /hls/<stazione>/live.m3u8): i pezzi audio li manda Caddy
	# direttamente dalla memoria; le playlist passano dal controllo, che conta gli ascoltatori
	@hls_pezzo path_regexp hls_pezzo ^/hls/[A-Za-z0-9_.-]+/([A-Za-z0-9_]+\.ts)$
	handle @hls_pezzo {
		root * /hls
		rewrite * /{re.hls_pezzo.1}
		header Content-Type video/mp2t
		header Access-Control-Allow-Origin *
		header Cache-Control "public, max-age=60"
		file_server
	}
	# tutto il resto: player pubblico (/), pannello remoto (/dashboard), regia, ospiti
	handle {
		reverse_proxy controllo:9080
	}
}

# Ascolto senza https per i lettori vecchi (http://DOMINIO:8000/radio.mp3, stesso indirizzo di prima):
# Caddy passa tutto a Icecast tranne l'amministrazione, che in chiaro non deve viaggiare
# (la password passerebbe leggibile in rete). L'amministrazione si apre da https://DOMINIO/admin/.
http://:8000 {
	@admin path /admin /admin/*
	respond @admin "Amministrazione di Icecast solo in HTTPS: https://{$DOMINIO}/admin/" 403
	reverse_proxy icecast:8000 {
		flush_interval -1
	}
}
